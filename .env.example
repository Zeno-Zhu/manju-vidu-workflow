# 复制为 .env 后填入你自己的 Vidu Token（.env 不进 git）
#
# Token 获取：https://www.vidu.cn → 个人中心 → API Token（vda_ 开头）
# 闲时创作 = 每天 200 条、不消耗积分；同时进行中最多 100 条。

VIDU_BASE_URL=https://service.vidu.cn

# 单账号：只填这一行即可
VIDU_TOKEN=

# 多账号：一账号一行，用 --account N 切换
# VIDU_TOKEN_1=
# VIDU_TOKEN_2=
# VIDU_TOKEN_3=
VIDU_DEFAULT_ACCOUNT=1
